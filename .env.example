# Copy this file to .env.local and fill in values once the club's Supabase
# project exists. Until these are set, the whole site reads and writes
# through the local JSON files in src/data instead, so it works fully
# without a database.

# Supabase project URL and anon key, found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key, used only in server side API routes (never exposed to
# the browser). Needed for writing membership applications and contact
# messages once Supabase is connected.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the demo login session cookie. Change this to a long
# random string before putting the site online, even in demo mode.
SESSION_SECRET=change-this-to-a-long-random-string
